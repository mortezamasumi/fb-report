{
    "name": "mortezamasumi/fb-report",
    "description": "Generate PDF reports using mPDF for Filament.",
    "keywords": [
        "mortezamasumi",
        "laravel",
        "filament",
        "fb-report",
        "pdf",
        "mpdf"
    ],
    "homepage": "https://github.com/mortezamasumi/fb-report",
    "support": {
        "issues": "https://github.com/mortezamasumi/fb-report/issues",
        "source": "https://github.com/mortezamasumi/fb-report"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Morteza Masumi",
            "email": "morteza.masumi@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "carlos-meneses/laravel-mpdf": "^2.1.11",
        "filament/filament": "^5.0",
        "mortezamasumi/fb-essentials": "^5.0",
        "spatie/laravel-package-tools": "^1.0"
    },
    "require-dev": {
        "filament/upgrade": "^5.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-browser": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "smalot/pdfparser": "^2.12",
        "symfony/dom-crawler": "^7.3",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Mortezamasumi\\FbReport\\": "src/",
            "Mortezamasumi\\FbReport\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mortezamasumi\\FbReport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "pint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mortezamasumi\\FbReport\\FbReportServiceProvider"
            ],
            "aliases": {
                "FbReport": "Mortezamasumi\\FbReport\\Facades\\FbReport"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
